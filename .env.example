# ---------------------------------------------------------------------------
# PermitFees — environment template
#
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
#
# `.env.local` is read by the app (Next.js) and by scripts that run outside Next
# (`drizzle-kit migrate`, `npm run db:seed`) through `scripts/load-env.ts`, so
# there is a single place to put credentials. `.env.local` wins over `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon pooled connection string).
# Server-only. This value must never reach the browser bundle.
# Neon free plan: use the "-pooler" host for the app, and the direct host for
# drizzle-kit migrations if a migration needs a session connection.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/permit_fee?sslmode=require"

# Public site origin, used to build absolute/canonical URLs and the sitemap.
# No trailing slash. Production domain:
NEXT_PUBLIC_SITE_URL="https://permitfees.site"
# (For local development you may point this at "http://localhost:3000" instead;
# canonicals, sitemap and robots all derive from this single variable via
# src/lib/site.ts, so there is no second place to update.)

# Marks the deployment as indexable. Search engines must not index previews,
# staging, or localhost builds. Keep "false" for every local/preview environment
# and set "true" only on the production deployment (it is inlined at build time,
# so the flip must happen on the production build together with the real domain
# above).
NEXT_PUBLIC_SITE_INDEXABLE="false"

# Optional: public contact address shown on /contact/.
# Leave empty and the contact page will say corrections cannot be received yet,
# rather than showing an address that bounces.
NEXT_PUBLIC_CONTACT_EMAIL=""

# Optional: Google Search Console verification token (see SEO.md).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
